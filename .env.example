# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# NOTIFICATION_WEBHOOK_URL: Optional external Slack/Discord/Make webhook for real-time lead alerts
NOTIFICATION_WEBHOOK_URL=

# EMAIL_SERVICE_API_KEY: Optional API key for transactional email provider (Resend/SendGrid)
EMAIL_SERVICE_API_KEY=

# NOTIFICATION_EMAIL_TO: Destination email address for new lead notifications
NOTIFICATION_EMAIL_TO=

# FIREBASE_PROJECT_ID: Optional override for Firebase project ID (defaults to provisioned project)
FIREBASE_PROJECT_ID=

# FIREBASE_SERVICE_ACCOUNT: Optional JSON string for service account credentials if running outside GCP ADC
FIREBASE_SERVICE_ACCOUNT=
