rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /audit_submissions/{auditId} {
      allow read, write: if true;
    }

    match /contact_submissions/{contactId} {
      allow read, write: if true;
    }

    match /_health/{docId} {
      allow read, write: if true;
    }
  }
}
