rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Legacy owner-only access used by the current Experts data paths.
    // Team access is introduced collection-by-collection so membership never
    // accidentally grants access to private mentoring data.
    function ownsExpertWorkspace(workspaceId) {
      return request.auth != null && request.auth.uid == workspaceId;
    }

    function isExpertWorkspaceMember(workspaceId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/expert_workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function hasWorkspacePermission(workspaceId, permission) {
      return request.auth != null && (
        request.auth.uid == workspaceId ||
        (isExpertWorkspaceMember(workspaceId) &&
          ('*' in get(/databases/$(database)/documents/expert_workspaces/$(workspaceId)/members/$(request.auth.uid)).data.permissions ||
           permission in get(/databases/$(database)/documents/expert_workspaces/$(workspaceId)/members/$(request.auth.uid)).data.permissions))
      );
    }

    function authEmailMatches(email) {
      return request.auth != null &&
        request.auth.token.email is string &&
        request.auth.token.email_verified == true &&
        request.auth.token.email == email;
    }

    function validWorkspaceCore(data) {
      return data.keys().hasAll([
          'schemaVersion', 'name', 'ownerUid', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schemaVersion', 'name', 'ownerUid', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.schemaVersion == 1 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 160 &&
        data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128 &&
        data.status in ['active', 'suspended', 'archived'] &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validWorkspaceUser(data, uid) {
      return data.keys().hasAll([
          'schemaVersion', 'email', 'displayName', 'photoURL', 'activeWorkspaceId',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schemaVersion', 'email', 'displayName', 'photoURL', 'activeWorkspaceId',
          'createdAt', 'updatedAt'
        ]) &&
        data.schemaVersion == 1 &&
        uid == request.auth.uid &&
        data.email is string && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() <= 160 &&
        data.photoURL is string && data.photoURL.size() <= 1000 &&
        data.activeWorkspaceId is string && data.activeWorkspaceId.size() > 0 && data.activeWorkspaceId.size() <= 128 &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validWorkspaceRole(data) {
      return data.keys().hasAll([
          'schemaVersion', 'name', 'description', 'permissions', 'isSystem',
          'createdByUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schemaVersion', 'name', 'description', 'permissions', 'isSystem',
          'createdByUid', 'createdAt', 'updatedAt'
        ]) &&
        data.schemaVersion == 1 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.description is string && data.description.size() <= 500 &&
        data.permissions is list && data.permissions.size() <= 100 &&
        data.isSystem is bool &&
        data.createdByUid is string && data.createdByUid.size() > 0 && data.createdByUid.size() <= 128 &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validWorkspaceMember(data, memberId) {
      return data.keys().hasAll([
          'schemaVersion', 'uid', 'email', 'displayName', 'roleId', 'permissions',
          'status', 'joinedAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schemaVersion', 'uid', 'email', 'displayName', 'roleId', 'permissions',
          'status', 'inviteId', 'joinedAt', 'updatedAt'
        ]) &&
        data.schemaVersion == 1 &&
        data.uid is string && data.uid == memberId &&
        data.email is string && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() <= 160 &&
        data.roleId is string && data.roleId.size() > 0 && data.roleId.size() <= 120 &&
        data.permissions is list && data.permissions.size() <= 100 &&
        data.status in ['active', 'invited', 'suspended'] &&
        (!('inviteId' in data) || (data.inviteId is string && data.inviteId.size() <= 200)) &&
        data.joinedAt is timestamp && data.updatedAt is timestamp;
    }

    function validWorkspaceInvite(data) {
      return data.keys().hasAll([
          'schemaVersion', 'displayName', 'email', 'normalizedEmail', 'roleId', 'permissions',
          'status', 'invitedByUid', 'expiresAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schemaVersion', 'displayName', 'email', 'normalizedEmail', 'roleId', 'permissions',
          'status', 'invitedByUid', 'expiresAt', 'createdAt', 'updatedAt'
        ]) &&
        data.schemaVersion == 1 &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 160 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 254 &&
        data.normalizedEmail is string && data.normalizedEmail.size() >= 5 && data.normalizedEmail.size() <= 254 &&
        data.roleId is string && data.roleId.size() > 0 && data.roleId.size() <= 120 &&
        data.permissions is list && data.permissions.size() <= 100 &&
        data.status in ['pending', 'accepted', 'revoked', 'expired'] &&
        data.invitedByUid is string && data.invitedByUid.size() > 0 && data.invitedByUid.size() <= 128 &&
        data.expiresAt is timestamp && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validRelationshipEvent(data) {
      return data.keys().hasAll([
          'schemaVersion', 'personId', 'type', 'sourceType', 'sourceId', 'actorUid',
          'idempotencyKey', 'metadata', 'occurredAt', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'schemaVersion', 'personId', 'type', 'sourceType', 'sourceId', 'actorUid',
          'idempotencyKey', 'metadata', 'occurredAt', 'createdAt'
        ]) &&
        data.schemaVersion == 1 &&
        data.personId is string && data.personId.size() > 0 && data.personId.size() <= 160 &&
        data.type is string && data.type.size() > 0 && data.type.size() <= 160 &&
        data.sourceType is string && data.sourceType.size() <= 120 &&
        data.sourceId is string && data.sourceId.size() <= 200 &&
        data.actorUid is string && data.actorUid == request.auth.uid &&
        data.idempotencyKey is string && data.idempotencyKey.size() <= 240 &&
        data.metadata is map &&
        data.occurredAt is timestamp && data.createdAt is timestamp;
    }

    function validWorkspaceAuditLog(data) {
      return data.keys().hasAll([
          'schemaVersion', 'entityType', 'entityId', 'action', 'actorUid',
          'changes', 'occurredAt', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'schemaVersion', 'entityType', 'entityId', 'action', 'actorUid',
          'changes', 'occurredAt', 'createdAt'
        ]) &&
        data.schemaVersion == 1 &&
        data.entityType is string && data.entityType.size() > 0 && data.entityType.size() <= 120 &&
        data.entityId is string && data.entityId.size() <= 200 &&
        data.action is string && data.action.size() > 0 && data.action.size() <= 160 &&
        data.actorUid is string && data.actorUid == request.auth.uid &&
        data.changes is map &&
        data.occurredAt is timestamp && data.createdAt is timestamp;
    }

    function validExpertClientMemory(data, clientId) {
      return data.keys().hasAll(['schemaVersion', 'updatedAt']) &&
        data.keys().hasOnly([
          'schemaVersion', 'record', 'session', 'outcomeMemory', 'migratedAt', 'updatedAt'
        ]) &&
        data.schemaVersion == 1 &&
        data.updatedAt is timestamp &&
        (!('migratedAt' in data) || data.migratedAt is timestamp) &&
        (!('outcomeMemory' in data) || data.outcomeMemory is map) &&
        ('record' in data || 'session' in data) &&
        (!('record' in data) ||
          (data.record is map &&
           data.record.id is string &&
           data.record.id == clientId)) &&
        (!('session' in data) ||
          (data.session is map &&
           data.session.id is string &&
           data.session.id == clientId));
    }

    function validExpertJournalEntry(data, entryId) {
      return data.keys().hasAll(['schemaVersion', 'entry', 'updatedAt']) &&
        data.keys().hasOnly(['schemaVersion', 'entry', 'migratedAt', 'updatedAt']) &&
        data.schemaVersion == 1 &&
        data.updatedAt is timestamp &&
        (!('migratedAt' in data) || data.migratedAt is timestamp) &&
        data.entry is map &&
        data.entry.id is string &&
        data.entry.id == entryId &&
        data.entry.clientId is string &&
        data.entry.createdAt is string;
    }

    function validExpertSessionSummary(data, summaryId) {
      return data.keys().hasAll(['schemaVersion', 'summary', 'updatedAt']) &&
        data.keys().hasOnly(['schemaVersion', 'summary', 'migratedAt', 'updatedAt']) &&
        data.schemaVersion == 1 &&
        data.updatedAt is timestamp &&
        (!('migratedAt' in data) || data.migratedAt is timestamp) &&
        data.summary is map &&
        data.summary.id is string &&
        data.summary.id == summaryId &&
        data.summary.clientId is string &&
        data.summary.createdAt is string;
    }

    function validExpertWorkTask(data, taskId) {
      return data.keys().hasAll(['schemaVersion', 'task', 'updatedAt']) &&
        data.keys().hasOnly(['schemaVersion', 'task', 'migratedAt', 'updatedAt']) &&
        data.schemaVersion == 1 &&
        data.updatedAt is timestamp &&
        (!('migratedAt' in data) || data.migratedAt is timestamp) &&
        data.task is map &&
        data.task.id is string &&
        data.task.id == taskId &&
        data.task.clientId is string &&
        data.task.createdAt is string &&
        data.task.type in ['email', 'whatsapp', 'call', 'meeting', 'task'] &&
        data.task.status in ['pending', 'in-progress', 'done'] &&
        (!('assignedToUid' in data.task) || data.task.assignedToUid is string) &&
        (!('createdByUid' in data.task) || data.task.createdByUid is string) &&
        (!('completedByUid' in data.task) || data.task.completedByUid is string);
    }

    function validExpertWorkspaceSettings(data) {
      return data.keys().hasAll([
          'schemaVersion', 'profile', 'appearance', 'language', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schemaVersion', 'profile', 'appearance', 'language', 'migratedAt', 'updatedAt'
        ]) &&
        data.schemaVersion == 1 &&
        data.updatedAt is timestamp &&
        (!('migratedAt' in data) || data.migratedAt is timestamp) &&
        data.profile is map &&
        data.profile.keys().hasAll(['name', 'business', 'role']) &&
        data.profile.keys().hasOnly(['name', 'business', 'role']) &&
        data.profile.name is string && data.profile.name.size() <= 120 &&
        data.profile.business is string && data.profile.business.size() <= 160 &&
        data.profile.role is string && data.profile.role.size() <= 120 &&
        data.appearance is map &&
        data.appearance.keys().hasAll(['theme', 'intensity', 'sidebar', 'sidebarIntensity']) &&
        data.appearance.keys().hasOnly(['theme', 'intensity', 'sidebar', 'sidebarIntensity']) &&
        data.appearance.theme is string && data.appearance.theme.size() <= 40 &&
        data.appearance.intensity is int &&
        data.appearance.intensity >= 1 && data.appearance.intensity <= 10 &&
        data.appearance.sidebar is string && data.appearance.sidebar.size() <= 40 &&
        data.appearance.sidebarIntensity is int &&
        data.appearance.sidebarIntensity >= 1 && data.appearance.sidebarIntensity <= 10 &&
        data.language in ['es', 'en'];
    }

    function validExpertPerson(data) {
      return data.keys().hasAll([
          'schemaVersion', 'name', 'email', 'phone', 'normalizedEmail',
          'normalizedPhone', 'firstSource', 'latestSource', 'currentStage',
          'outcomeMemory', 'sourceRefs', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schemaVersion', 'name', 'email', 'phone', 'normalizedEmail',
          'normalizedPhone', 'firstSource', 'latestSource', 'currentStage',
          'outcomeMemory', 'sourceRefs', 'createdAt', 'updatedAt'
        ]) &&
        data.schemaVersion == 1 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 160 &&
        data.email is string && data.email.size() <= 254 &&
        data.phone is string && data.phone.size() <= 40 &&
        data.normalizedEmail is string && data.normalizedEmail.size() <= 254 &&
        data.normalizedPhone is string && data.normalizedPhone.size() <= 40 &&
        (data.normalizedEmail.size() > 0 || data.normalizedPhone.size() > 0) &&
        data.firstSource is string && data.firstSource.size() <= 120 &&
        data.latestSource is string && data.latestSource.size() <= 120 &&
        data.currentStage in ['lead', 'webinar', 'student', 'alumni', 'mentoring'] &&
        data.outcomeMemory is map &&
        data.sourceRefs is map &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function validExpertWebinar(data) {
      return data.keys().hasAll([
          'schemaVersion', 'title', 'startsAt', 'source', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schemaVersion', 'title', 'startsAt', 'source', 'platform', 'externalUrl',
          'offerLabel', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.schemaVersion == 1 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 240 &&
        data.startsAt is string && data.startsAt.size() <= 40 &&
        data.source is string && data.source.size() <= 120 &&
        (!('platform' in data) || (data.platform is string && data.platform.size() <= 120)) &&
        (!('externalUrl' in data) || (data.externalUrl is string && data.externalUrl.size() <= 2000)) &&
        (!('offerLabel' in data) || (data.offerLabel is string && data.offerLabel.size() <= 240)) &&
        data.status in ['draft', 'scheduled', 'completed', 'cancelled'] &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validExpertWebinarRegistration(data) {
      return data.keys().hasAll([
          'schemaVersion', 'personId', 'webinarId', 'status', 'attendanceMinutes',
          'purchased', 'interest', 'registeredAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schemaVersion', 'personId', 'webinarId', 'status', 'attendanceMinutes',
          'purchased', 'interest', 'followUpTaskId', 'followUpStatus', 'followUpResult',
          'followUpCompletedAt', 'registeredAt', 'updatedAt'
        ]) &&
        data.schemaVersion == 1 &&
        data.personId is string && data.personId.size() > 0 && data.personId.size() <= 120 &&
        data.webinarId is string && data.webinarId.size() > 0 && data.webinarId.size() <= 120 &&
        data.status in ['registered', 'attended', 'no-show'] &&
        data.attendanceMinutes is int && data.attendanceMinutes >= 0 && data.attendanceMinutes <= 10000 &&
        data.purchased is bool &&
        data.interest in ['unknown', 'low', 'medium', 'high'] &&
        (!('followUpTaskId' in data) || (data.followUpTaskId is string && data.followUpTaskId.size() <= 240)) &&
        (!('followUpStatus' in data) || data.followUpStatus in ['needed', 'created', 'completed', 'not-needed']) &&
        (!('followUpResult' in data) || (data.followUpResult is string && data.followUpResult.size() <= 4000)) &&
        (!('followUpCompletedAt' in data) || data.followUpCompletedAt is timestamp) &&
        data.registeredAt is timestamp && data.updatedAt is timestamp;
    }

    function validExpertFormation(data) {
      return data.keys().hasAll(['schemaVersion', 'title', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['schemaVersion', 'title', 'status', 'createdAt', 'updatedAt']) &&
        data.schemaVersion == 1 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 240 &&
        data.status in ['draft', 'active', 'archived'] &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validExpertCohort(data) {
      return data.keys().hasAll([
          'schemaVersion', 'formationId', 'title', 'startsAt', 'endsAt',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schemaVersion', 'formationId', 'title', 'startsAt', 'endsAt',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        data.schemaVersion == 1 &&
        data.formationId is string && data.formationId.size() > 0 && data.formationId.size() <= 120 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 240 &&
        data.startsAt is string && data.startsAt.size() <= 40 &&
        data.endsAt is string && data.endsAt.size() <= 40 &&
        data.status in ['planned', 'active', 'completed', 'cancelled'] &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validExpertEnrollment(data) {
      return data.keys().hasAll([
          'schemaVersion', 'personId', 'formationId', 'cohortId', 'status',
          'progress', 'joinedAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schemaVersion', 'personId', 'formationId', 'cohortId', 'status',
          'progress', 'joinedAt', 'updatedAt'
        ]) &&
        data.schemaVersion == 1 &&
        data.personId is string && data.personId.size() > 0 && data.personId.size() <= 120 &&
        data.formationId is string && data.formationId.size() > 0 && data.formationId.size() <= 120 &&
        data.cohortId is string && data.cohortId.size() > 0 && data.cohortId.size() <= 120 &&
        data.status in ['active', 'completed', 'withdrawn', 'refunded'] &&
        data.progress is int && data.progress >= 0 && data.progress <= 100 &&
        data.joinedAt is timestamp && data.updatedAt is timestamp;
    }

    function validAudit(data, auditId) {
      return data.keys().hasAll([
          'id', 'name', 'company', 'email', 'contactChannel',
          'status', 'createdAt', 'notificationStatus'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'company', 'website', 'email', 'contactChannel',
          'inquiryNotes', 'status', 'createdAt', 'notificationStatus'
        ]) &&
        data.id is string &&
        data.id == auditId &&
        data.id.matches('^GK-AUD-[A-Z0-9-]+$') &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.company is string && data.company.size() > 0 && data.company.size() <= 150 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 254 &&
        data.email.matches('^.+@.+[.].+$') &&
        data.contactChannel in [
          'WhatsApp', 'Website', 'Email', 'Instagram', 'Phone', 'Multiple channels'
        ] &&
        data.status == 'PENDING_REVIEW' &&
        data.notificationStatus == 'PENDING' &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        (!('website' in data) || (data.website is string && data.website.size() <= 250)) &&
        (!('inquiryNotes' in data) || (data.inquiryNotes is string && data.inquiryNotes.size() <= 2000));
    }

    function validContact(data, contactId) {
      return data.keys().hasAll([
          'id', 'name', 'email', 'message', 'status', 'createdAt', 'notificationStatus'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'email', 'message', 'status', 'createdAt', 'notificationStatus'
        ]) &&
        data.id is string &&
        data.id == contactId &&
        data.id.matches('^GK-CON-[A-Z0-9-]+$') &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 254 &&
        data.email.matches('^.+@.+[.].+$') &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 5000 &&
        data.status == 'PENDING_REVIEW' &&
        data.notificationStatus == 'PENDING' &&
        data.createdAt is string && data.createdAt.size() <= 40;
    }

    function validImportedLead(data, leadId) {
      return data.keys().hasAll([
          'id', 'name', 'email', 'phone', 'status', 'createdAt',
          'updatedAt', 'notificationStatus', 'assignedTo', 'nextAction',
          'followUpAt', 'internalNotes', 'leadNotes', 'activityLog',
          'importedBy', 'importBatchId'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'company', 'email', 'phone', 'website', 'contactChannel',
          'businessType', 'primaryService', 'digitalPresence', 'acquisitionChannel',
          'leadVolume', 'currentCrm', 'primaryProblem', 'currentSolution',
          'businessGoal', 'inquiryNotes', 'status', 'createdAt', 'updatedAt',
          'notificationStatus', 'assignedTo', 'nextAction', 'followUpAt',
          'internalNotes', 'leadNotes', 'activityLog', 'importedBy', 'importBatchId'
        ]) &&
        data.id is string &&
        data.id == leadId &&
        data.id.matches('^GK-IMP-[A-Z0-9-]+') &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() <= 254 &&
        data.phone is string && data.phone.size() <= 40 &&
        (data.email.size() > 0 || data.phone.size() > 0) &&
        (!('company' in data) || (data.company is string && data.company.size() <= 150)) &&
        (!('website' in data) || (data.website is string && data.website.size() <= 250)) &&
        (!('contactChannel' in data) || (data.contactChannel is string && data.contactChannel.size() <= 80)) &&
        (!('businessType' in data) || (data.businessType is string && data.businessType.size() <= 160)) &&
        (!('primaryService' in data) || (data.primaryService is string && data.primaryService.size() <= 300)) &&
        (!('digitalPresence' in data) || (data.digitalPresence is string && data.digitalPresence.size() <= 500)) &&
        (!('acquisitionChannel' in data) || (data.acquisitionChannel is string && data.acquisitionChannel.size() <= 300)) &&
        (!('leadVolume' in data) || (data.leadVolume is string && data.leadVolume.size() <= 160)) &&
        (!('currentCrm' in data) || (data.currentCrm is string && data.currentCrm.size() <= 200)) &&
        (!('primaryProblem' in data) || (data.primaryProblem is string && data.primaryProblem.size() <= 1200)) &&
        (!('currentSolution' in data) || (data.currentSolution is string && data.currentSolution.size() <= 1200)) &&
        (!('businessGoal' in data) || (data.businessGoal is string && data.businessGoal.size() <= 1200)) &&
        (!('inquiryNotes' in data) || (data.inquiryNotes is string && data.inquiryNotes.size() <= 2000)) &&
        data.status == 'NEW' &&
        data.notificationStatus == 'IMPORTED' &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.updatedAt is string && data.updatedAt.size() <= 40 &&
        data.assignedTo is string && data.assignedTo.size() <= 100 &&
        data.nextAction is string && data.nextAction.size() <= 240 &&
        data.followUpAt is string && data.followUpAt.size() <= 40 &&
        data.internalNotes is string && data.internalNotes.size() <= 3000 &&
        data.leadNotes is list && data.leadNotes.size() <= 50 &&
        data.activityLog is list && data.activityLog.size() <= 20 &&
        data.importedBy is string && data.importedBy.size() <= 120 &&
        data.importBatchId is string && data.importBatchId.size() <= 80;
    }

    function validOperationalUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'website', 'businessType', 'primaryService', 'digitalPresence',
          'acquisitionChannel', 'leadVolume', 'currentCrm', 'primaryProblem',
          'currentSolution', 'businessGoal', 'assignedTo', 'nextAction', 'followUpAt',
          'internalNotes', 'leadNotes', 'activityLog', 'updatedAt'
        ]) &&
        request.resource.data.status in [
          'PENDING_REVIEW', 'NEW', 'CONTACTED', 'FOLLOW_UP',
          'MEETING', 'CLIENT', 'LOST'
        ] &&
        (!('website' in request.resource.data) ||
          (request.resource.data.website is string &&
           request.resource.data.website.size() <= 250)) &&
        (!('businessType' in request.resource.data) ||
          (request.resource.data.businessType is string &&
           request.resource.data.businessType.size() <= 160)) &&
        (!('primaryService' in request.resource.data) ||
          (request.resource.data.primaryService is string &&
           request.resource.data.primaryService.size() <= 300)) &&
        (!('digitalPresence' in request.resource.data) ||
          (request.resource.data.digitalPresence is string &&
           request.resource.data.digitalPresence.size() <= 500)) &&
        (!('acquisitionChannel' in request.resource.data) ||
          (request.resource.data.acquisitionChannel is string &&
           request.resource.data.acquisitionChannel.size() <= 300)) &&
        (!('leadVolume' in request.resource.data) ||
          (request.resource.data.leadVolume is string &&
           request.resource.data.leadVolume.size() <= 160)) &&
        (!('currentCrm' in request.resource.data) ||
          (request.resource.data.currentCrm is string &&
           request.resource.data.currentCrm.size() <= 200)) &&
        (!('primaryProblem' in request.resource.data) ||
          (request.resource.data.primaryProblem is string &&
           request.resource.data.primaryProblem.size() <= 1200)) &&
        (!('currentSolution' in request.resource.data) ||
          (request.resource.data.currentSolution is string &&
           request.resource.data.currentSolution.size() <= 1200)) &&
        (!('businessGoal' in request.resource.data) ||
          (request.resource.data.businessGoal is string &&
           request.resource.data.businessGoal.size() <= 1200)) &&
        request.resource.data.assignedTo is string &&
        request.resource.data.assignedTo.size() <= 100 &&
        request.resource.data.nextAction is string &&
        request.resource.data.nextAction.size() <= 240 &&
        request.resource.data.followUpAt is string &&
        request.resource.data.followUpAt.size() <= 40 &&
        request.resource.data.internalNotes is string &&
        request.resource.data.internalNotes.size() <= 3000 &&
        (!('leadNotes' in request.resource.data) ||
          (request.resource.data.leadNotes is list &&
           request.resource.data.leadNotes.size() <= 50)) &&
        request.resource.data.activityLog is list &&
        request.resource.data.activityLog.size() <= 20 &&
        request.resource.data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        validWorkspaceUser(request.resource.data, uid) &&
        (request.resource.data.activeWorkspaceId == uid ||
          getAfter(/databases/$(database)/documents/expert_workspaces/$(request.resource.data.activeWorkspaceId)/members/$(uid)).data.uid == uid);
      allow delete: if false;
    }

    match /audit_submissions/{auditId} {
      allow create: if validAudit(request.resource.data, auditId);
      allow read: if isAdmin();
      allow update: if isAdmin() && validOperationalUpdate();
      allow delete: if isAdmin();
    }

    match /contact_submissions/{contactId} {
      allow create: if validContact(request.resource.data, contactId);
      allow read: if isAdmin();
      allow update: if isAdmin() && validOperationalUpdate();
      allow delete: if isAdmin();
    }

    match /business_knowledge/{knowledgeId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() &&
        knowledgeId == 'default' &&
        request.resource.data.keys().hasAll([
          'businessName', 'businessDescription', 'offers', 'idealCustomer',
          'qualificationCriteria', 'faqObjections', 'policies', 'tone', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'businessName', 'businessDescription', 'offers', 'idealCustomer',
          'qualificationCriteria', 'faqObjections', 'policies', 'tone', 'updatedAt'
        ]) &&
        request.resource.data.businessName is string &&
        request.resource.data.businessName.size() <= 160 &&
        request.resource.data.businessDescription is string &&
        request.resource.data.businessDescription.size() <= 4000 &&
        request.resource.data.offers is string &&
        request.resource.data.offers.size() <= 5000 &&
        request.resource.data.idealCustomer is string &&
        request.resource.data.idealCustomer.size() <= 4000 &&
        request.resource.data.qualificationCriteria is string &&
        request.resource.data.qualificationCriteria.size() <= 4000 &&
        request.resource.data.faqObjections is string &&
        request.resource.data.faqObjections.size() <= 5000 &&
        request.resource.data.policies is string &&
        request.resource.data.policies.size() <= 4000 &&
        request.resource.data.tone is string &&
        request.resource.data.tone.size() <= 2000 &&
        request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /expert_workspaces/{workspaceId} {
      allow read: if request.auth != null &&
        (request.auth.uid == workspaceId || isExpertWorkspaceMember(workspaceId));
      allow create: if request.auth != null &&
        request.resource.data.ownerUid == request.auth.uid &&
        validWorkspaceCore(request.resource.data);
      allow update: if hasWorkspacePermission(workspaceId, 'settings.manage') &&
        validWorkspaceCore(request.resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    match /expert_workspaces/{workspaceId}/roles/{roleId} {
      allow read: if ownsExpertWorkspace(workspaceId) ||
        hasWorkspacePermission(workspaceId, 'roles.read') ||
        hasWorkspacePermission(workspaceId, 'roles.manage');
      allow create, update: if hasWorkspacePermission(workspaceId, 'roles.manage') &&
        validWorkspaceRole(request.resource.data) &&
        (request.auth.uid == workspaceId ||
          request.resource.data.permissions.hasOnly(
            get(/databases/$(database)/documents/expert_workspaces/$(workspaceId)/members/$(request.auth.uid)).data.permissions
          ));
      allow delete: if hasWorkspacePermission(workspaceId, 'roles.manage') &&
        roleId != 'owner';
    }

    match /expert_workspaces/{workspaceId}/members/{memberId} {
      allow read: if ownsExpertWorkspace(workspaceId) ||
        (request.auth != null && request.auth.uid == memberId) ||
        hasWorkspacePermission(workspaceId, 'members.read') ||
        hasWorkspacePermission(workspaceId, 'members.manage');

      allow create: if (
          hasWorkspacePermission(workspaceId, 'members.manage') &&
          validWorkspaceMember(request.resource.data, memberId) &&
          (request.auth.uid == workspaceId ||
            request.resource.data.permissions.hasOnly(
              get(/databases/$(database)/documents/expert_workspaces/$(workspaceId)/members/$(request.auth.uid)).data.permissions
            ))
        ) || (
          request.auth != null && request.auth.uid == memberId &&
          validWorkspaceMember(request.resource.data, memberId) &&
          request.resource.data.status == 'active' &&
          ('inviteId' in request.resource.data) &&
          request.resource.data.inviteId.size() > 0 &&
          exists(/databases/$(database)/documents/expert_workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)) &&
          get(/databases/$(database)/documents/expert_workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)).data.status == 'pending' &&
          request.time < get(/databases/$(database)/documents/expert_workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)).data.expiresAt &&
          authEmailMatches(get(/databases/$(database)/documents/expert_workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)).data.normalizedEmail) &&
          request.resource.data.roleId == get(/databases/$(database)/documents/expert_workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)).data.roleId &&
          request.resource.data.permissions == get(/databases/$(database)/documents/expert_workspaces/$(workspaceId)/invites/$(request.resource.data.inviteId)).data.permissions
        );

      allow update: if hasWorkspacePermission(workspaceId, 'members.manage') &&
        validWorkspaceMember(request.resource.data, memberId) &&
        (request.auth.uid == workspaceId ||
          request.resource.data.permissions.hasOnly(
            get(/databases/$(database)/documents/expert_workspaces/$(workspaceId)/members/$(request.auth.uid)).data.permissions
          ));
      allow delete: if hasWorkspacePermission(workspaceId, 'members.manage') &&
        memberId != workspaceId;
    }

    match /expert_workspaces/{workspaceId}/invites/{inviteId} {
      allow read: if hasWorkspacePermission(workspaceId, 'members.manage') ||
        (resource.data.normalizedEmail is string && authEmailMatches(resource.data.normalizedEmail));
      allow create: if hasWorkspacePermission(workspaceId, 'members.manage') &&
        validWorkspaceInvite(request.resource.data) &&
        (request.auth.uid == workspaceId ||
          request.resource.data.permissions.hasOnly(
            get(/databases/$(database)/documents/expert_workspaces/$(workspaceId)/members/$(request.auth.uid)).data.permissions
          ));
      allow update: if (
          hasWorkspacePermission(workspaceId, 'members.manage') &&
          validWorkspaceInvite(request.resource.data) &&
          (request.auth.uid == workspaceId ||
            request.resource.data.permissions.hasOnly(
              get(/databases/$(database)/documents/expert_workspaces/$(workspaceId)/members/$(request.auth.uid)).data.permissions
            ))
        ) || (
          authEmailMatches(resource.data.normalizedEmail) &&
          request.time < resource.data.expiresAt &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.updatedAt is timestamp
        );
      allow delete: if hasWorkspacePermission(workspaceId, 'members.manage');
    }

    match /expert_workspaces/{workspaceId}/relationship_events/{eventId} {
      allow read: if hasWorkspacePermission(workspaceId, 'events.read');
      allow create: if hasWorkspacePermission(workspaceId, 'events.create') &&
        validRelationshipEvent(request.resource.data);
      allow update, delete: if false;
    }

    match /expert_workspaces/{workspaceId}/audit_logs/{logId} {
      allow read: if hasWorkspacePermission(workspaceId, 'audit.read');
      allow create: if request.auth != null &&
        (request.auth.uid == workspaceId || isExpertWorkspaceMember(workspaceId)) &&
        validWorkspaceAuditLog(request.resource.data);
      allow update, delete: if false;
    }

    match /expert_workspaces/{workspaceId}/clients/{clientId} {
      allow read: if ownsExpertWorkspace(workspaceId);
      allow create, update: if ownsExpertWorkspace(workspaceId) &&
        validExpertClientMemory(request.resource.data, clientId);
      allow delete: if ownsExpertWorkspace(workspaceId);
    }

    match /expert_workspaces/{workspaceId}/journal_entries/{entryId} {
      allow read: if ownsExpertWorkspace(workspaceId);
      allow create, update: if ownsExpertWorkspace(workspaceId) &&
        validExpertJournalEntry(request.resource.data, entryId);
      allow delete: if ownsExpertWorkspace(workspaceId);
    }

    match /expert_workspaces/{workspaceId}/session_summaries/{summaryId} {
      allow read: if ownsExpertWorkspace(workspaceId);
      allow create, update: if ownsExpertWorkspace(workspaceId) &&
        validExpertSessionSummary(request.resource.data, summaryId);
      allow delete: if ownsExpertWorkspace(workspaceId);
    }

    match /expert_workspaces/{workspaceId}/work_tasks/{taskId} {
      allow read: if ownsExpertWorkspace(workspaceId) ||
        hasWorkspacePermission(workspaceId, 'tasks.read.team') ||
        (hasWorkspacePermission(workspaceId, 'tasks.read.own') &&
          resource.data.task.assignedToUid == request.auth.uid);

      allow create: if validExpertWorkTask(request.resource.data, taskId) && (
        hasWorkspacePermission(workspaceId, 'tasks.manage') ||
        (hasWorkspacePermission(workspaceId, 'tasks.manage.own') &&
          request.resource.data.task.assignedToUid == request.auth.uid)
      );

      allow update: if validExpertWorkTask(request.resource.data, taskId) && (
        hasWorkspacePermission(workspaceId, 'tasks.manage') ||
        (hasWorkspacePermission(workspaceId, 'tasks.manage.own') &&
          resource.data.task.assignedToUid == request.auth.uid &&
          request.resource.data.task.assignedToUid == request.auth.uid)
      );

      allow delete: if hasWorkspacePermission(workspaceId, 'tasks.manage') ||
        (hasWorkspacePermission(workspaceId, 'tasks.manage.own') &&
          resource.data.task.assignedToUid == request.auth.uid);
    }

    match /expert_workspaces/{workspaceId}/settings/{settingsId} {
      allow read: if ownsExpertWorkspace(workspaceId) && settingsId == 'workspace';
      allow create, update: if ownsExpertWorkspace(workspaceId) &&
        settingsId == 'workspace' &&
        validExpertWorkspaceSettings(request.resource.data);
      allow delete: if ownsExpertWorkspace(workspaceId) && settingsId == 'workspace';
    }

    match /expert_workspaces/{workspaceId}/people/{personId} {
      allow read: if ownsExpertWorkspace(workspaceId);
      allow create, update: if ownsExpertWorkspace(workspaceId) &&
        validExpertPerson(request.resource.data);
      allow delete: if ownsExpertWorkspace(workspaceId);
    }

    match /expert_workspaces/{workspaceId}/webinars/{webinarId} {
      allow read: if ownsExpertWorkspace(workspaceId);
      allow create, update: if ownsExpertWorkspace(workspaceId) &&
        validExpertWebinar(request.resource.data);
      allow delete: if ownsExpertWorkspace(workspaceId);
    }

    match /expert_workspaces/{workspaceId}/webinar_registrations/{registrationId} {
      allow read: if ownsExpertWorkspace(workspaceId) || (
        resource.data.followUpTaskId is string &&
        resource.data.followUpTaskId.size() > 0 &&
        (hasWorkspacePermission(workspaceId, 'tasks.manage') ||
          (hasWorkspacePermission(workspaceId, 'tasks.manage.own') &&
            get(/databases/$(database)/documents/expert_workspaces/$(workspaceId)/work_tasks/$(resource.data.followUpTaskId)).data.task.assignedToUid == request.auth.uid))
      );
      allow create: if ownsExpertWorkspace(workspaceId) &&
        validExpertWebinarRegistration(request.resource.data);
      allow update: if validExpertWebinarRegistration(request.resource.data) && (
        ownsExpertWorkspace(workspaceId) || (
          resource.data.followUpTaskId is string &&
          resource.data.followUpTaskId.size() > 0 &&
          (hasWorkspacePermission(workspaceId, 'tasks.manage') ||
            (hasWorkspacePermission(workspaceId, 'tasks.manage.own') &&
              get(/databases/$(database)/documents/expert_workspaces/$(workspaceId)/work_tasks/$(resource.data.followUpTaskId)).data.task.assignedToUid == request.auth.uid)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'followUpStatus', 'followUpResult', 'followUpCompletedAt', 'updatedAt'
          ]) &&
          request.resource.data.followUpStatus == 'completed'
        )
      );
      allow delete: if ownsExpertWorkspace(workspaceId);
    }

    match /expert_workspaces/{workspaceId}/formations/{formationId} {
      allow read: if ownsExpertWorkspace(workspaceId);
      allow create, update: if ownsExpertWorkspace(workspaceId) &&
        validExpertFormation(request.resource.data);
      allow delete: if ownsExpertWorkspace(workspaceId);
    }

    match /expert_workspaces/{workspaceId}/cohorts/{cohortId} {
      allow read: if ownsExpertWorkspace(workspaceId);
      allow create, update: if ownsExpertWorkspace(workspaceId) &&
        validExpertCohort(request.resource.data);
      allow delete: if ownsExpertWorkspace(workspaceId);
    }

    match /expert_workspaces/{workspaceId}/enrollments/{enrollmentId} {
      allow read: if ownsExpertWorkspace(workspaceId);
      allow create, update: if ownsExpertWorkspace(workspaceId) &&
        validExpertEnrollment(request.resource.data);
      allow delete: if ownsExpertWorkspace(workspaceId);
    }

    match /admins/{adminId} {
      // Admin membership is provisioned manually in Firestore. Clients cannot
      // list, read, create, update or delete administrator records.
      allow read, write: if false;
    }

    match /_health/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
