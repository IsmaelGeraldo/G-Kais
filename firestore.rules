rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validAudit(data, auditId) {
      return data.keys().hasAll([
          'id', 'name', 'company', 'email', 'contactChannel',
          'status', 'createdAt', 'notificationStatus'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'company', 'website', 'email', 'contactChannel',
          'inquiryNotes', 'status', 'createdAt', 'notificationStatus'
        ]) &&
        data.id is string &&
        data.id == auditId &&
        data.id.matches('^GK-AUD-[A-Z0-9-]+$') &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.company is string && data.company.size() > 0 && data.company.size() <= 150 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 254 &&
        data.email.matches('^.+@.+[.].+$') &&
        data.contactChannel in [
          'WhatsApp', 'Website', 'Email', 'Instagram', 'Phone', 'Multiple channels'
        ] &&
        data.status == 'PENDING_REVIEW' &&
        data.notificationStatus == 'PENDING' &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        (!('website' in data) || (data.website is string && data.website.size() <= 250)) &&
        (!('inquiryNotes' in data) || (data.inquiryNotes is string && data.inquiryNotes.size() <= 2000));
    }

    function validContact(data, contactId) {
      return data.keys().hasAll([
          'id', 'name', 'email', 'message', 'status', 'createdAt', 'notificationStatus'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'email', 'message', 'status', 'createdAt', 'notificationStatus'
        ]) &&
        data.id is string &&
        data.id == contactId &&
        data.id.matches('^GK-CON-[A-Z0-9-]+$') &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 254 &&
        data.email.matches('^.+@.+[.].+$') &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 5000 &&
        data.status == 'PENDING_REVIEW' &&
        data.notificationStatus == 'PENDING' &&
        data.createdAt is string && data.createdAt.size() <= 40;
    }

    match /audit_submissions/{auditId} {
      allow create: if validAudit(request.resource.data, auditId);
      // TODO: replace false with request.auth.uid == '<ADMIN_UID>' after first admin sign-in.
      allow read: if false;
      allow update, delete: if false;
    }

    match /contact_submissions/{contactId} {
      allow create: if validContact(request.resource.data, contactId);
      // TODO: replace false with request.auth.uid == '<ADMIN_UID>' after first admin sign-in.
      allow read: if false;
      allow update, delete: if false;
    }

    match /_health/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
