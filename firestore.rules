rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validAudit(data, auditId) {
      return data.keys().hasAll([
          'id', 'name', 'company', 'email', 'contactChannel',
          'status', 'createdAt', 'notificationStatus'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'company', 'website', 'email', 'contactChannel',
          'inquiryNotes', 'status', 'createdAt', 'notificationStatus'
        ]) &&
        data.id is string &&
        data.id == auditId &&
        data.id.matches('^GK-AUD-[A-Z0-9-]+$') &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.company is string && data.company.size() > 0 && data.company.size() <= 150 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 254 &&
        data.email.matches('^.+@.+[.].+$') &&
        data.contactChannel in [
          'WhatsApp', 'Website', 'Email', 'Instagram', 'Phone', 'Multiple channels'
        ] &&
        data.status == 'PENDING_REVIEW' &&
        data.notificationStatus == 'PENDING' &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        (!('website' in data) || (data.website is string && data.website.size() <= 250)) &&
        (!('inquiryNotes' in data) || (data.inquiryNotes is string && data.inquiryNotes.size() <= 2000));
    }

    function validContact(data, contactId) {
      return data.keys().hasAll([
          'id', 'name', 'email', 'message', 'status', 'createdAt', 'notificationStatus'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'email', 'message', 'status', 'createdAt', 'notificationStatus'
        ]) &&
        data.id is string &&
        data.id == contactId &&
        data.id.matches('^GK-CON-[A-Z0-9-]+$') &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 254 &&
        data.email.matches('^.+@.+[.].+$') &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 5000 &&
        data.status == 'PENDING_REVIEW' &&
        data.notificationStatus == 'PENDING' &&
        data.createdAt is string && data.createdAt.size() <= 40;
    }

    function validOperationalUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'assignedTo', 'nextAction', 'followUpAt',
          'internalNotes', 'updatedAt'
        ]) &&
        request.resource.data.status in [
          'PENDING_REVIEW', 'NEW', 'CONTACTED', 'FOLLOW_UP',
          'MEETING', 'CLIENT', 'LOST'
        ] &&
        request.resource.data.assignedTo is string &&
        request.resource.data.assignedTo.size() <= 100 &&
        request.resource.data.nextAction is string &&
        request.resource.data.nextAction.size() <= 240 &&
        request.resource.data.followUpAt is string &&
        request.resource.data.followUpAt.size() <= 40 &&
        request.resource.data.internalNotes is string &&
        request.resource.data.internalNotes.size() <= 3000;
    }

    match /audit_submissions/{auditId} {
      allow create: if validAudit(request.resource.data, auditId);
      allow read: if isAdmin();
      allow update: if isAdmin() && validOperationalUpdate();
      allow delete: if false;
    }

    match /contact_submissions/{contactId} {
      allow create: if validContact(request.resource.data, contactId);
      allow read: if isAdmin();
      allow update: if isAdmin() && validOperationalUpdate();
      allow delete: if false;
    }

    match /admins/{adminId} {
      // Admin membership is provisioned manually in Firestore. Clients cannot
      // list, read, create, update or delete administrator records.
      allow read, write: if false;
    }

    match /_health/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
