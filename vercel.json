{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/[...].js": {
      "maxDuration": 60,
      "includeFiles": "server-build/server.mjs"
    },
    "api/webhooks/stripe.js": {
      "maxDuration": 60,
      "includeFiles": "server-build/stripeWebhook.cjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/webhooks/stripe",
      "destination": "/api/webhooks/stripe"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/[...]"
    },
    {
      "source": "/workspace",
      "destination": "/index.html"
    },
    {
      "source": "/workspace/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/hq",
      "destination": "/index.html"
    },
    {
      "source": "/hq/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/demo/experts",
      "destination": "/index.html"
    },
    {
      "source": "/demo/experts/:path*",
      "destination": "/index.html"
    }
  ]
}
